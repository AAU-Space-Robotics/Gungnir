  </link>
  <joint name="joint_6" type="revolute">
    <origin rpy="0 0 3.1416" xyz="0.000 0 0.03625" />
    <parent link="link_5" />
    <child link="link_6" />
    <axis xyz="0 0 1" />
    <limit lower="-2.9147" upper="2.9671" effort="-1" velocity="1.0472" />
  </joint>

  <!-- Center of the end effector mounting surface on link 6 -->
  <link name="ee_link" />
  <joint name="ee_joint" type="fixed">
    <parent link="link_6" />
    <child link="ee_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>


  <!-- Ros2 control parameters -->
  <ros2_control>
  
    <hardware>
      <plugin>gungnir_interface/GungnirInterface</plugin>
    </hardware>

    <joint name="joint_1">
        <command_interface name="position">
          <param name="min">-150</param>
          <param name="max">184</param>
        </command_interface>
        <command_interface name="velocity" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <param name="position_offset">184</param>
      </joint>

      <joint name="joint_2">
        <command_interface name="position">
